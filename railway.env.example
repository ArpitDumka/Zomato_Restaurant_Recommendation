# Example variables for Railway (service → Variables).
# Do not commit real secrets. See Docs/Deployment.md.

# --- Optional LLM / Hub (same as local phase6/.env) ---
# OPENAI_API_KEY=
# GROQ_API_KEY=
# HF_TOKEN=

# --- CORS for Vercel (required for browser calls from *.vercel.app) ---
# Recommended (matches Deployment.md):
CORS_ORIGIN_REGEX=https://[^/]+\.vercel\.app$

# Optional: explicit production URL(s), comma-separated (custom domain, etc.)
# CORS_ORIGINS=https://your-app.vercel.app

# --- Catalog size (memory) on Railway ---
# Default: ZOMATO_RAILWAY_DEFAULT_CAP=12000 normalized rows + HF streaming + startup warmup.
# Raise cap if you add RAM: ZOMATO_RAILWAY_DEFAULT_CAP=20000
# For full ~52k in memory: ZOMATO_FULL_CATALOG=1 (needs a large instance)
# ZOMATO_RAILWAY_DEFAULT_CAP=12000
# HF: on Railway default streaming (low RAM). For speed + enough RAM: ZOMATO_HF_STREAMING=0
# ZOMATO_HF_STREAMING=0
# Startup catalog load (default on Railway). Skip: ZOMATO_CATALOG_WARMUP=0
# ZOMATO_CATALOG_WARMUP=0
# Optional: limit filter dropdown size (frequency order); omit for all cities/cuisines
# ZOMATO_FILTER_MAX_CITIES=80
# ZOMATO_FILTER_MAX_CUISINES=60
# ZOMATO_FULL_CATALOG=1
# ZOMATO_MAX_CATALOG_ROWS=40000

# --- Logs: line-buffered Python output in Railway logs ---
PYTHONUNBUFFERED=1
