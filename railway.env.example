# Example variables for Railway (service → Variables).
# Do not commit real secrets. See Docs/Deployment.md.

# --- Optional LLM / Hub (same as local phase6/.env) ---
# OPENAI_API_KEY=
# GROQ_API_KEY=
# HF_TOKEN=

# --- CORS for Vercel (required for browser calls from *.vercel.app) ---
# Recommended (matches Deployment.md):
CORS_ORIGIN_REGEX=https://[^/]+\.vercel\.app$

# Optional: explicit production URL(s), comma-separated (custom domain, etc.)
# CORS_ORIGINS=https://your-app.vercel.app

# --- Catalog size (memory) on Railway ---
# If Railway env vars are present and you do NOT set ZOMATO_MAX_CATALOG_ROWS, the API
# loads at most ZOMATO_RAILWAY_DEFAULT_CAP rows (default 15000) to avoid OOM on small plans.
# For full ~52k rows on a larger instance: ZOMATO_FULL_CATALOG=1
# Or set an explicit cap: ZOMATO_MAX_CATALOG_ROWS=52000
# ZOMATO_RAILWAY_DEFAULT_CAP=15000
# Filter dropdown size on Railway (JSON/DOM): defaults 80 cities / 45 cuisines; 0 = unlimited
# ZOMATO_FILTER_MAX_CITIES=0
# ZOMATO_FILTER_MAX_CUISINES=0
# ZOMATO_FULL_CATALOG=1
# ZOMATO_MAX_CATALOG_ROWS=40000

# --- Logs: line-buffered Python output in Railway logs ---
PYTHONUNBUFFERED=1
