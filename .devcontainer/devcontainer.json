{
  "name": "Python 3",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "Docs/Deployment.md"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "updateContentCommand": "pip3 install --user --upgrade pip && pip3 install --user -r requirements.txt",
  "postAttachCommand": {
    "api": "python3 -m uvicorn zomato_surface.app:create_app --factory --host 0.0.0.0 --port 8765"
  },
  "portsAttributes": {
    "8765": {
      "label": "Phase 6 API + UI",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8765
  ]
}
