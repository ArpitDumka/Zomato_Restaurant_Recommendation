# Local: point at Phase 6 FastAPI (repo root: .\run.ps1 -Surface)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8765

# Vercel (Production / Preview): set in Vercel → Project → Settings → Environment Variables.
# Use your Railway public API origin only — HTTPS, no trailing slash, e.g.:
# NEXT_PUBLIC_API_BASE_URL=https://your-service.up.railway.app
#
# Redeploy the Vercel project after changing NEXT_PUBLIC_* (values are baked at build time).
# On Railway, set CORS_ORIGIN_REGEX and/or CORS_ORIGINS so this origin can call the API.
# See Docs/Deployment.md in the repository root.
